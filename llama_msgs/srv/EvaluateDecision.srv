# Question types
uint8 CHOICE = 0
uint8 SCORE = 1
uint8 NOUL = 2

# Question
# choice: keys[i]/descriptions[i] are the option keys/text (descriptions optional)
# score: descriptions are the ordered levels (2 to 10); keys is ignored
# noul: descriptions[0]/descriptions[1] describe the false/true options (optional)
uint8 type
string instructions
string state
string[] keys
string[] descriptions
---
# Answer
bool success
string error
uint8 type
string choice
float32 score
float32 noul
float32 confidence
string[] keys
float32[] probabilities
